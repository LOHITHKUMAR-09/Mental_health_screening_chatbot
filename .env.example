# ============================================================
# ML Mental Health Screening Chatbot — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values

# --- App ---
APP_ENV=development
APP_SECRET_KEY=your-super-secret-key-change-in-production
APP_NAME="MindEase - Mental Health Chatbot"
APP_VERSION=1.0.0

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mindease_db
POSTGRES_USER=mindease_user
POSTGRES_PASSWORD=mindease_password
DATABASE_URL=postgresql://mindease_user:mindease_password@localhost:5432/mindease_db

# --- JWT Auth ---
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM Provider (choose one) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama3-8b-8192

# --- LLM Settings ---
LLM_PROVIDER=openai
LLM_TEMPERATURE=0.5
LLM_MAX_TOKENS=512

# --- Vector DB (pgvector inside PostgreSQL) ---
VECTOR_DIMENSION=1536

# --- Crisis Detection ---
CRISIS_KEYWORD_SENSITIVITY=high
ICALL_HELPLINE=9152987821
VANDREVALA_HELPLINE=1860-2662-345

# --- ML Model ---
ML_MODEL_PATH=ml/models/best_model.pkl
ML_SCALER_PATH=ml/models/scaler.pkl

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Redis (optional for session cache) ---
REDIS_URL=redis://localhost:6379

# --- Email (optional for notifications) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
